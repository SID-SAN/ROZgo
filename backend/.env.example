# ==============================================================================
# ROZgo Backend Environment Variables
# ==============================================================================

# Server Configuration
PORT=5000
ENVIRONMENT=development
CORS_ORIGIN=*

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Bucket Names in Supabase Storage
SUPABASE_BUCKET_DOCUMENTS=worker-documents
SUPABASE_BUCKET_MEDIA=public-media

# Authentication & JWT
JWT_SECRET=supersecret-jwt-signing-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

